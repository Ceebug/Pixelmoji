			"config": "pixelmoji.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "1.21.10",
		"java": ">=21",
		"fabric-api": "*",
		"glomphosche": "0.2.1"
	}
}

