{
	"schemaVersion": 1,
	"id": "pixelmoji",
	"version": "${version}",
	"name": "Pixelmoji",
	"description": "Proper emoji support for Minecraft.",
	"authors": [
		"Ceebug"
	],
	"contact": {
		"sources": "https://github.com/ceebug/pixelmoji"
	},
	"license": "CC0-1.0",
	"icon": "assets/pixelmoji/icon.png",
	"environment": "client",
	"entrypoints": {
